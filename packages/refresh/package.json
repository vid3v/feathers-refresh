  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@feathersjs/authentication": "^5.0.34",
    "@feathersjs/errors": "^5.0.34"
  },
  "peerDependencies": {
    "@feathersjs/feathers": "^5.0.34",
    "@feathersjs/koa": "^5.0.34",
    "koa": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "@feathersjs/koa": { "optional": true },
    "koa": { "optional": true }
  },
  "devDependencies": {
    "@feathersjs/authentication-local": "^5.0.34",
    "@feathersjs/feathers": "^5.0.34",
    "@feathersjs/koa": "^5.0.49",
    "@feathersjs/memory": "^5.0.34",
    "@types/koa": "^2.15.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "mocha": "^11.7.6",
    "shx": "^0.4.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
