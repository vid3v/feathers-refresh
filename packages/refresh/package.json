{
  "name": "feathers-authentication-refresh",
  "description": "Refresh token rotation, session revocation and reuse detection for FeathersJS authentication.",
  "version": "0.4.0",
  "homepage": "https://github.com/vid3v/feathers-refresh",
  "main": "lib/",
  "types": "lib/",
  "keywords": [
    "feathers",
    "feathers-plugin",
    "authentication",
    "refresh-token",
    "jwt",
    "security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/vid3v/feathers-refresh.git",
    "directory": "packages/refresh"
  },
  "author": {
    "name": "Vivien Tassing",
    "email": "vivientassing@aol.com"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src/**",
    "lib/**"
  ],
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "prepublishOnly": "npm run compile && npm test",
